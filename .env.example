# ——— Cliente (se incrustan en el build; no pongas secretos aquí) ———
# URL pública final, sin barra final. Activa canonical, og:url y og:image absoluta.
VITE_SITE_URL=
# Endpoint del formulario. Vacío = modo demo. En Vercel: /api/contact
VITE_CONTACT_ENDPOINT=
# Clave pública (site key) de Cloudflare Turnstile. Vacío = sin verificación antispam.
VITE_TURNSTILE_SITE_KEY=

# ——— Servidor (solo en la Vercel Function api/contact.ts; secretos) ———
RESEND_API_KEY=
# Buzón que recibe las consultas (admite varios separados por comas).
CONTACT_TO=
# Remitente en un dominio verificado en Resend, p. ej. "ALIVE Web <web@dominio.com>".
CONTACT_FROM=
TURNSTILE_SECRET_KEY=

# ——— Brief de proyecto (/brief-form/) ———
# Lo crea Vercel al conectar un Blob Store privado al proyecto.
BLOB_READ_WRITE_TOKEN=
# Secreto para firmar sesiones y enlaces a archivos (cadena aleatoria larga). Recomendado.
BRIEF_SECRET=

# ——— Panel de ALIVE (/panel/) y guardado de clientes en Supabase ———
# Públicas (se incrustan en el build): URL del proyecto y clave «publishable».
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Servidor (secretas): las funciones guardan briefs y consultas con la clave «secret».
SUPABASE_URL=
SUPABASE_SECRET_KEY=
