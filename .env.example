# Copia a .env.local para desarrollo. En GitHub se definen como variables del
# repositorio (Settings → Secrets and variables → Actions → Variables).

# URL pública final, sin barra final. Activa canonical, og:url y og:image absoluta.
VITE_SITE_URL=

# Endpoint del formulario (p. ej. https://formspree.io/f/xxxxxxx). Vacío = modo demo.
VITE_CONTACT_ENDPOINT=

# Enlace al aviso de privacidad. Aparece junto al botón de envío.
VITE_PRIVACY_URL=
